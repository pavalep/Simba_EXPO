<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/simba_native_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo stage: 220dp radial gold glow + 180dp orbiting sweep ring + 96dp SIMBA Lion -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/splash_glow"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:src="@drawable/splash_glow_radial"
                android:alpha="0.35"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/splash_loading_ring"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:src="@drawable/splash_ring_shape"
                android:alpha="0"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_splash_logo"
                android:scaleType="centerInside"
                android:alpha="1"
                android:scaleX="0.92"
                android:scaleY="0.92"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <TextView
            android:id="@+id/splash_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simba"
            android:fontFamily="@font/allura"
            android:textColor="@color/splash_wordmark"
            android:textSize="52sp"
            android:letterSpacing="0.01"
            android:includeFontPadding="false"
            android:alpha="0"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stories, sound &amp; cinema"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/splash_tagline"
            android:textSize="13sp"
            android:letterSpacing="0.05"
            android:alpha="0"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</FrameLayout>
